#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${DIR}/../lib/shared.bash"

if [[ "$(plugin_read_config DEBUG false)" =~ ^(true|on|1)$ ]]; then
  set -x
fi

if [[ -e "${STATE_DIR}" || -L "${STATE_DIR}" ]]; then
  # A failed setup can leave an existing directory that this job does not own.
  PYTHON3_CMD="$(_find_python3)"
  check_state_dir "${PYTHON3_CMD}"
  rm -rf "${STATE_DIR}"
fi
